# Answer generation provider: gemini or cohere
LLM_PROVIDER=gemini

# Required only for Gemini; fallback is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Required only for Cohere. Choose a model available to your API key.
COHERE_API_KEY=
COHERE_MODEL=command-a-plus-05-2026

CHROMA_PATH=chroma_db_html
